# INHERITANCE
# 1
class vehicle:
    def moves(self):
        print("Vehicle moves")
class car(vehicle):
    def moves(self):
        print("Car drives")
class bike(vehicle):
    def moves(self):
        print("Bike rides")
v=[car(), bike()]
for i in v:
    i.moves ()

#2
class person:
    def __init__(self,name):
        self.name=name
    def show(self):
        print("Name:", self.name)
class teacher(person):
    def __init__(self, name, subject): 
        super() .__init__(name)
        self.subject=subject
    def show_details(self):
        print("Name:", self.name)
        print("Subject:", self.subject)
t1=teacher("Dr. Rao", "English")
t1.show_details()
